#!/usr/bin/env -S python3 -I
"""Usage: mask-run '<shell invocation>'   (as CLAUDE_CODE_SHELL_PREFIX)

Runs the invocation with /bin/sh -c, or through $SECRETS_ORIG_PREFIX when set,
copying its stdout and stderr with every value the relay at $SECRETS_RELAY
knows, in any of its encoded forms, masked: the whitespace-delimited token
holding it becomes [secret]. Values shorter than $SECRETS_MASK_MIN characters
are skipped. Exits with the command's status. Without a relay the command
still runs; one line on stderr says its output is unmasked.
"""
import base64
import json
import os
import re
import select
import signal
import socket
import subprocess
import sys
from urllib.parse import quote, quote_plus

MASK = b'[secret]'
WHITESPACE = b' \t\n\r\f\v'
IDLE_SECONDS = 0.05
MAX_HOLD = 65536
PERCENT = re.compile(r'%[0-9A-F]{2}')


def forms(value):
    """The ways `value` turns up in output: raw, escaped, percent-, hex- and base64-encoded."""
    raw = value.encode('utf-8')
    texts = [
        json.dumps(value)[1:-1],
        json.dumps(value, ensure_ascii=False)[1:-1],
        value.replace("'", "'\\''"),
        value.replace("'", "'\"'\"'"),
    ]
    for encoded in (quote(value, safe=''), quote(value, safe="!~*'()"), quote_plus(value, safe='')):
        texts += [encoded, PERCENT.sub(lambda m: m.group().lower(), encoded)]
    found = {raw, raw.hex().encode(), raw.hex().upper().encode()}
    found.update(text.encode('utf-8') for text in texts)
    for encode in (base64.b64encode, base64.urlsafe_b64encode):
        for offset in range(3):
            # The characters fully determined by the value's bits, wherever it sits in the encoded run.
            encoded = encode(b'\0' * offset + raw + b'\0\0\0')
            found.add(encoded[-(-8 * offset // 6):(8 * (offset + len(raw))) // 6])
    found.discard(b'')
    return found


class Masker:
    def __init__(self, min_length):
        self.min_length = min_length
        self.patterns = set()

    def add(self, value):
        if len(value) >= self.min_length:
            self.patterns |= forms(value)

    def spans(self, data):
        """Each token holding a form, as merged (start, end) ranges."""
        found = []
        for pattern in self.patterns:
            at = data.find(pattern)
            while at >= 0:
                start, end = at, at + len(pattern)
                while start > 0 and data[start - 1] not in WHITESPACE:
                    start -= 1
                while end < len(data) and data[end] not in WHITESPACE:
                    end += 1
                found.append((start, end))
                at = data.find(pattern, at + 1)
        merged = []
        for start, end in sorted(found):
            if merged and start <= merged[-1][1]:
                merged[-1] = (merged[-1][0], max(merged[-1][1], end))
            else:
                merged.append((start, end))
        return merged

    def mask(self, data):
        out, at = [], 0
        for start, end in self.spans(data):
            out += [data[at:start], MASK]
            at = end
        out.append(data[at:])
        return b''.join(out)

    def partial(self, data):
        """How many trailing bytes could still grow into a form."""
        longest = 0
        for pattern in self.patterns:
            for size in range(min(len(pattern) - 1, len(data)), longest, -1):
                if pattern.startswith(data[-size:]):
                    longest = size
                    break
        return longest

    def cut(self, data, idle):
        """How much of `data` can be masked and written now: the rest may still grow into a token holding a form."""
        if idle:
            cut = len(data) - self.partial(data)
        else:
            last = max(data.rfind(bytes([c])) for c in WHITESPACE)
            cut = min(last + 1, len(data) - self.partial(data))
            if len(data) - cut > MAX_HOLD:
                cut = len(data) - max((len(p) for p in self.patterns), default=0)
        for start, end in self.spans(data):
            if start < cut < end:
                cut = start
        return cut


class Refused(Exception):
    pass


class Watch:
    """The relay's GET /watch stream: an HTTP head, then one JSON string per line."""

    def __init__(self, masker):
        self.masker = masker
        self.raw = b''
        self.in_body = False

    def feed(self, data):
        self.raw += data
        if not self.in_body:
            end = self.raw.find(b'\r\n\r\n')
            if end < 0:
                return
            status = self.raw.split(b'\r\n', 1)[0].split(b' ')[1]
            if status != b'200':
                raise Refused(status.decode('ascii', 'replace'))
            self.raw = self.raw[end + 4:]
            self.in_body = True
        *lines, self.raw = self.raw.split(b'\n')
        for line in lines:
            self.masker.add(json.loads(line))


def connect(path):
    """A socket streaming the relay's values, or None."""
    if not path:
        return None
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(path)
        sock.sendall(b'GET /watch HTTP/1.0\r\n\r\n')
    except OSError:
        return None
    sock.setblocking(False)
    return sock


def write_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def drain(sock, watch):
    while True:
        try:
            data = sock.recv(65536)
        except BlockingIOError:
            return sock
        except OSError:
            return None
        if data == b'':
            return None
        try:
            watch.feed(data)
        except Refused as refused:
            sys.stderr.write(f'mask-run: the secrets relay refused this process ({refused}); this output is not masked\n')
            sys.stderr.flush()
            return None


def main():
    if len(sys.argv) != 2:
        sys.exit('mask-run: usage: mask-run <shell invocation>')
    invocation = sys.argv[1]
    prefix = os.environ.get('SECRETS_ORIG_PREFIX')
    argv = [prefix, invocation] if prefix else ['/bin/sh', '-c', invocation]

    sock = connect(os.environ.get('SECRETS_RELAY'))
    if sock is None:
        sys.stderr.write('mask-run: no secrets relay; this output is not masked\n')
        sys.stderr.flush()
        os.execv(argv[0], argv)

    try:
        min_length = int(os.environ['SECRETS_MASK_MIN'])
    except (KeyError, ValueError):
        sys.stderr.write('mask-run: SECRETS_MASK_MIN is not a number; masking values of any length\n')
        sys.stderr.flush()
        min_length = 1

    child = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda signum, _frame: child.send_signal(signum))

    masker = Masker(min_length)
    watch = Watch(masker)
    held = {child.stdout.fileno(): b'', child.stderr.fileno(): b''}
    sinks = {child.stdout.fileno(): 1, child.stderr.fileno(): 2}
    # Held bytes an idle flush already kept back: only more output can change them.
    settled = set()

    def flush(fd, data, idle):
        cut = masker.cut(data, idle)
        write_all(sinks[fd], masker.mask(data[:cut]))
        held[fd] = data[cut:]
        if idle:
            settled.add(fd)
        else:
            settled.discard(fd)

    while held:
        watched = [sock] if sock is not None else []
        waiting = any(data and fd not in settled for fd, data in held.items())
        readable, _, _ = select.select(list(held) + watched, [], [], IDLE_SECONDS if waiting else None)
        if sock is not None:
            sock = drain(sock, watch)
        if not readable:
            for fd, data in list(held.items()):
                if data and fd not in settled:
                    flush(fd, data, idle=True)
            continue
        for fd in readable:
            if fd not in held:
                continue
            data = os.read(fd, 65536)
            if data == b'':
                write_all(sinks[fd], masker.mask(held.pop(fd)))
                continue
            flush(fd, held[fd] + data, idle=False)

    status = child.wait()
    sys.exit(128 - status if status < 0 else status)


if __name__ == '__main__':
    main()
